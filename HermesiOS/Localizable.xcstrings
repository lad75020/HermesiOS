            "value" : "Use Settings → Host Companion to authenticate this iOS device before editing Hermes memory files and provider configuration on the macOS host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Ajustes → Host Companion para autenticar este dispositivo iOS antes de editar archivos de memoria de Hermes y la configuración de proveedores en el host macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Réglages → Compagnon hôte pour authentifier cet appareil iOS avant de modifier les fichiers de mémoire Hermes et la configuration des fournisseurs sur l’hôte macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
