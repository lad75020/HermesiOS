    "Use Settings → Host Companion to authenticate this iOS device before editing Hermes memory files and provider configuration on the macOS host." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende Einstellungen → Host Companion, um dieses iOS-Gerät zu authentifizieren, bevor du Hermes-Speicherdateien und Anbieter-Konfiguration auf dem macOS-Host bearbeitest."
          }
        },
        "en" : {
          "stringUnit" : {
