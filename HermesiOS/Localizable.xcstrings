          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta los documentos de Supermemory creados desde el disparador de exportación anterior a un archivo JSONL en el Mac y luego importa ese delta en la memoria de Hermes y los archivos de referencia de habilidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte les documents Supermemory créés depuis le déclenchement d’export précédent dans un fichier JSONL sur le Mac, puis importe ce delta dans la mémoire Hermes et les fichiers de référence des skills."
          }
        },
