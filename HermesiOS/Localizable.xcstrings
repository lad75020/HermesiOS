    "Exports Supermemory documents created since the previous export trigger into a JSONL file on the Mac, then imports that delta into Hermes memory and skill-reference files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiert seit dem vorherigen Export-Trigger erstellte Supermemory-Dokumente in eine JSONL-Datei auf dem Mac und importiert dieses Delta anschließend in Hermes-Speicher- und Skill-Referenzdateien."
          }
        },
        "en" : {
          "stringUnit" : {
